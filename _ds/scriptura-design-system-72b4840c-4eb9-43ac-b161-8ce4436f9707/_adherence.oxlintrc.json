{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data-display/**",
              "components/forms/**",
              "components/navigation/**",
              "components/progress/**",
              "patches/core/**",
              "ui_kits/scriptura/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Noto Sans Myanmar|Noto Sans Devanagari|Noto Sans JP|Noto Sans KR|Noto Sans SC|Noto Sans Telugu|Noto Sans Sinhala|Noto Sans Tamil))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Noto Sans Myanmar, Noto Sans Devanagari, Noto Sans JP, Noto Sans KR, Noto Sans SC, Noto Sans Telugu, Noto Sans Sinhala, Noto Sans Tamil."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accent|size|icon|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, accent, size, icon, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ariaLabel|disabled|key|ref|className|style|children)$/]",
        "message": "<NavButton> doesn't accept that prop. Declared props: children, ariaLabel, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|native|nativeFont|active|accent|onClick|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, native, nativeFont, active, accent, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:indic|cjk|practice|quiz|sheet|review)$/]",
        "message": "<Pill> accent must be one of 'indic' | 'cjk' | 'practice' | 'quiz' | 'sheet' | 'review'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|stroke|accent|color|label|sublabel|children|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, max, size, stroke, accent, color, label, sublabel, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:practice|quiz|sheet|review|indic|cjk)$/]",
        "message": "<ProgressRing> accent must be one of 'practice' | 'quiz' | 'sheet' | 'review' | 'indic' | 'cjk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|value|step|onChange|label|suffix|showValue|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: min, max, value, step, onChange, label, suffix, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|accent|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:practice|quiz|sheet|review|indic|cjk)$/]",
        "message": "<SegmentedControl> accent must be one of 'practice' | 'quiz' | 'sheet' | 'review' | 'indic' | 'cjk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|block|key|ref|className|style|children)$/]",
        "message": "<StatChip> doesn't accept that prop. Declared props: value, label, tone, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|correct|incorrect|streak|quiz|practice)$/]",
        "message": "<StatChip> tone must be one of 'neutral' | 'correct' | 'incorrect' | 'streak' | 'quiz' | 'practice'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|count|active|accent|layout|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Tab> doesn't accept that prop. Declared props: children, icon, count, active, accent, layout, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:practice|quiz|sheet|review|indic|cjk)$/]",
        "message": "<Tab> accent must be one of 'practice' | 'quiz' | 'sheet' | 'review' | 'indic' | 'cjk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:inline|stacked)$/]",
        "message": "<Tab> layout must be one of 'inline' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|level|accent|showValue|style|key|ref|className|style|children)$/]",
        "message": "<XPBar> doesn't accept that prop. Declared props: value, max, level, accent, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPBar'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:practice|quiz|indic|review)$/]",
        "message": "<XPBar> accent must be one of 'practice' | 'quiz' | 'indic' | 'review'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
